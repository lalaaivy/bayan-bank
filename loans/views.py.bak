@client_required
def portal_loan_agreement(request, loan_id):
    """Display a client's loan agreement."""

    loan = get_object_or_404(
        Loan.objects.select_related(
            "product",
            "client__user",
        ),
        pk=loan_id,
        client=request.client,
    )

    agreement = get_object_or_404(
        LoanAgreement,
        loan=loan,
    )

    return render(
        request,
        "portal/loan_agreement.html",
        {
            "loan": loan,
            "agreement": agreement,
        },
    )


@client_required
@require_POST
def portal_accept_agreement(request, loan_id):
    """Allow a borrower to accept their loan agreement."""

    loan = get_object_or_404(
        Loan,
        pk=loan_id,
        client=request.client,
    )

    if request.POST.get("accept") != "yes":
        messages.error(
            request,
            "Please confirm that you accept the agreement.",
        )

        return redirect(
            "portal_loan_agreement",
            loan_id=loan.pk,
        )

    _run(
        request,
        "Loan agreement accepted successfully.",
        services.accept_loan_agreement,
        loan.pk,
        request.user,
    )

    return redirect(
        "portal_loan_agreement",
        loan_id=loan.pk,
    )


@login_required
def loan_agreement_pdf(request, loan_id):
    """Generate and display a loan agreement PDF."""

    loan = get_object_or_404(
        Loan.objects.select_related(
            "product",
            "client__user",
        ),
        pk=loan_id,
    )

    role = _user_role(request.user)

    if role == "client":
        if loan.client.user_id != request.user.pk:
            raise PermissionDenied

    elif role not in STAFF:
        raise PermissionDenied

    agreement = get_object_or_404(
        LoanAgreement,
        loan=loan,
    )

    try:
        pdf = generate_agreement_pdf(
            loan,
            agreement,
        )

    except TypeError:
        pdf = generate_agreement_pdf(
            agreement
        )

    if hasattr(pdf, "getvalue"):
        pdf = pdf.getvalue()

    response = HttpResponse(
        pdf,
        content_type="application/pdf",
    )

    response["Content-Disposition"] = (
        f'inline; filename="{agreement.agreement_number}.pdf"'
    )

    return response


