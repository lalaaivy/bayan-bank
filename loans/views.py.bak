# ==========================================
# STAFF LOAN DETAILS
# ==========================================

@role_required(*STAFF)
def staff_loan(request, loan_id):
    """Display detailed information about a loan."""

    loan = get_object_or_404(
        Loan.objects.select_related(
            "client__user",
            "product",
        ),
        pk=loan_id,
    )

    agreement = LoanAgreement.objects.filter(
        loan=loan
    ).first()

    bank_account = BankAccount.objects.filter(
        client=loan.client
    ).first()

    disbursement = (
        Disbursement.objects.filter(
            loan=loan
        )
        .select_related(
            "bank_account",
            "disbursed_by",
            "ledger_entry",
        )
        .first()
    )

    installments = list(
        loan.installments.order_by("number")
    )

    total_due = sum(
        (
            installment.total_due
            for installment in installments
        ),
        Decimal("0.00"),
    )

    total_installment_paid = sum(
        (
            installment.amount_paid
            for installment in installments
        ),
        Decimal("0.00"),
    )

    remaining_balance = max(
        total_due - total_installment_paid,
        Decimal("0.00"),
    )

    payment_history = (
        LoanPayment.objects.filter(
            loan=loan
        )
        .select_related(
            "ledger_entry",
            "recorded_by",
        )
        .order_by("-payment_date", "-pk")
    )

    total_paid = (
        LoanPayment.objects.filter(
            loan=loan
        ).aggregate(
            total=Sum("amount")
        )["total"]
        or Decimal("0.00")
    )

    current_role = _user_role(request.user)

    return render(
        request,
        "staff/loan_detail.html",
        {
            "loan": loan,
            "installments": installments,
            "bank_account": bank_account,
            "agreement": agreement,
            "disbursement": disbursement,
            "eligibility": loan.eligibility_checks.order_by(
                "-checked_at"
            ).first(),
            "documents": loan.documents.order_by(
                "-uploaded_at"
            ),
            "total_due": total_due,
            "total_paid": total_paid,
            "total_installment_paid": total_installment_paid,
            "remaining_balance": remaining_balance,
            "payment_history": payment_history,
            "can_decide": current_role in DECIDERS,
            "can_create_agreement": current_role in STAFF,
            "can_disburse": current_role in DISBURSERS,
            "can_record_payment": current_role in PAYMENT_TAKERS,
        },
    )


