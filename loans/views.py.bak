# ==========================================
# STAFF: REJECT LOAN
# ==========================================

@role_required(*DECIDERS)
@require_POST
def staff_loan_reject(request, loan_id):
    _run(
        request,
        "Loan rejected.",
        services.reject_loan,
        loan_id,
        request.user,
        request.POST.get("reason", "").strip(),
    )

    return redirect(
        "staff_loan",
        loan_id=loan_id,
    )


# ==========================================
# STAFF: CREATE LOAN AGREEMENT
# ==========================================

@role_required(*STAFF)
@require_POST
def staff_create_agreement(request, loan_id):
    loan = get_object_or_404(
        Loan,
        pk=loan_id,
    )

    _run(
        request,
        "Loan agreement created.",
        services.create_loan_agreement,
        loan.pk,
        f"AGR-{loan.pk:06d}",
        timezone.localdate(),
        (
            "The borrower agrees to repay the loan "
            "according to the agreed installment schedule. "
            "Late payments may result in penalties. "
            "The loan will only be disbursed after "
            "the borrower accepts this agreement."
        ),
    )

    return redirect(
        "staff_loan",
        loan_id=loan.pk,
    )


# ==========================================
# STAFF: DISBURSE LOAN
# ==========================================

@role_required(*DISBURSERS)
@require_POST
def staff_loan_disburse(request, loan_id):
    """Disburse loan proceeds to the client's regular bank account."""

    loan = get_object_or_404(
        Loan,
        pk=loan_id,
    )

    account = get_object_or_404(
        BankAccount,
        pk=_int(request.POST.get("account")),
        client=loan.client,
        status=BankAccount.Status.ACTIVE,
    )

    _run(
        request,
        "Loan disbursed to the client's regular bank account.",
        services.disburse_loan,
        loan.pk,
        request.user,
        account.pk,
    )

    return redirect(
        "staff_loan",
        loan_id=loan_id,
    )


# ==========================================
# STAFF: RECORD PAYMENT
# ==========================================

@role_required(*PAYMENT_TAKERS)
@require_POST
def staff_loan_pay(request, loan_id):
    """Allow authorized staff to record a loan payment."""

    _run(
        request,
        "Payment recorded.",
        services.record_payment,
        loan_id,
        request.POST.get("amount"),
        request.user,
    )

    return redirect(
        "staff_loan",
        loan_id=loan_id,
    )


# ==========================================
# CALENDAR
# ==========================================

@login_required
def calendar_page(request):
    """Display the loan installment calendar."""

    if _user_role(request.user) not in STAFF + ("client",):
        raise PermissionDenied

    return render(
        request,
        "loans/calendar.html",
    )


@login_required
def calendar_events(request):
    """Return loan installment events for the calendar."""

    role = _user_role(request.user)

    qs = Installment.objects.select_related(
        "loan__client__user",
        "loan__product",
    )

    if role == "client":
        try:
            qs = qs.filter(
                loan__client=request.user.client_profile
            )

        except ObjectDoesNotExist:
            raise PermissionDenied

    elif role not in STAFF:
        raise PermissionDenied

    start = parse_date(
        (request.GET.get("start") or "")[:10]
    )

    end = parse_date(
        (request.GET.get("end") or "")[:10]
    )

    if start and end:
        qs = qs.filter(
            due_date__gte=start,
            due_date__lt=end,
        )

    today = timezone.localdate()

    events = []

    for installment in qs[:1000]:
        amount = (
            installment.principal_due
            + installment.interest_due
        )

        if installment.status == Installment.Status.PAID:
            color = "#198754"

        elif (
            installment.status == Installment.Status.OVERDUE
            or installment.due_date < today
        ):
            color = "#dc3545"

        else:
            color = "#0d6efd"

        title = f"₱ {amount:,.2f}"

        if role != "client":
            title = (
                f"{installment.loan.client} · {title}"
            )

        event = {
            "title": title,
            "start": installment.due_date.isoformat(),
            "color": color,
            "allDay": True,
        }

        if role != "client":
            event["url"] = (
                f"/staff/loans/{installment.loan_id}/"
            )

        events.append(event)

    return JsonResponse(
        events,
        safe=False,
    )
